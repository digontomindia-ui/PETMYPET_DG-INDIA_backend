# --- App ---
NODE_ENV=development
PORT=4000
API_VERSION=v1
APP_NAME=Patmypets
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
LOG_LEVEL=info

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017/patmypets

# --- Redis (cache, rate-limit store, BullMQ broker) ---
REDIS_URL=redis://localhost:6379

# --- JWT ---
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- OTP ---
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# --- Password reset ---
PASSWORD_RESET_TTL_SECONDS=900

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Firebase (push notifications) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Patmypets <no-reply@patmypets.com>

# --- SMS ---
SMS_API_KEY=
SMS_SENDER_ID=PATMYP

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SERVICE_NAME=patmypets-backend
METRICS_ENABLED=true

# --- Business config (never hardcode) ---
DEFAULT_PLATFORM_COMMISSION_PERCENT=15
BOOKING_AUTO_CANCEL_MINUTES=15
CURRENCY=INR
